# Demo EnsalsateQ: carpeta estática; anula las reglas del sitio principal
Options -Indexes
DirectorySlash On
DirectoryIndex index.html
RewriteEngine On
RewriteRule (^|/)\.git(/|$) - [F,L]
<FilesMatch "^(README|\.git.*)">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
